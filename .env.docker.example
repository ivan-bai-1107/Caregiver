JWT_SECRET_KEY=please-change-this-for-local-development

# Docker default uses the frontend Nginx proxy, so browser requests stay on port 5173.
# Use an absolute URL only when deploying the API separately.
VITE_API_BASE_URL=__RELATIVE__

EMAIL_PROVIDER=console
EMAIL_DEBUG_CODE=true
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USE_SSL=true
SMTP_USE_STARTTLS=false
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_FROM_NAME=Caregiver 护理助手
EMAIL_SEND_TIMEOUT_SECONDS=10

AI_PROVIDER=deepseek
AI_USE_REAL_MODEL=true
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

CONTENT_MODERATION_ENABLED=true
CONTENT_MODERATION_BASE_URL=https://v1.apizero.cn
CONTENT_MODERATION_PATH=/api/content-moderation
CONTENT_MODERATION_API_KEY=
CONTENT_MODERATION_TIMEOUT_SECONDS=10

# First run seeds demo data once. Set RESET_DEMO_DATA_ON_START=true to rebuild demo data.
SEED_DEMO_DATA_ON_START=true
RESET_DEMO_DATA_ON_START=false
